<%
  # The root page. A signer should never reach it: the logo is no longer a link
  # and every link we send is a /s/<slug>. But a mistyped or truncated URL lands
  # here, and upstream renders "DocuSeal v3.1.5" plus open-source marketing copy
  # under Hamilton's own logo, which is a competitor's product page wearing our
  # mark, shown to someone who was trying to sign an employment document.
  # So: say who this is, give them a way to reach a human, and nothing else.
  #
  # Two ERB traps, both hit while writing this file:
  #  1. a multi-line ternary inside an output tag is a Ruby syntax error and
  #     500s the entire page, so strings are assigned first;
  #  2. an ERB comment cannot contain a closing tag delimiter or the comment
  #     ends early and the rest of the prose renders as visible text. Hence a
  #     plain Ruby block with # comments rather than the <%# ... form.
  es = params[:lang].to_s == 'es' || I18n.locale.to_s.start_with?('es')
  heading = es ? 'Firma de documentos de Hamilton Exteriors' : 'Hamilton Exteriors document signing'
  body = es ? 'Esta página no es para firmar. Usa el enlace que Alex te mandó por WhatsApp.' : 'There is nothing to sign on this page. Use the link Alex sent you on WhatsApp.'
  call_label = es ? 'Llamar al (650) 977-3241' : 'Call (650) 977-3241'
  whatsapp_label = es ? 'Escribir por WhatsApp' : 'Message us on WhatsApp'
%>
<main class="flex items-center justify-center" aria-labelledby="landing-heading">
  <section class="py-10 mx-auto max-w-xl px-4 text-center">
    <div class="relative flex flex-col items-center">
      <%= render 'shared/logo', height: 88 %>
    </div>
    <h1 id="landing-heading" class="mt-6 mb-2 text-xl font-semibold" style="color:rgb(13,43,29)"><%= heading %></h1>
    <p class="mb-6" style="color:rgb(45,45,48)"><%= body %></p>
    <nav aria-label="<%= es ? 'Opciones de ayuda' : 'Help options' %>" class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="tel:+16509773241" class="hx-phone inline-flex items-center justify-center px-5" style="min-height:44px"><%= call_label %></a>
      <a href="https://wa.me/16509773241" class="hx-phone inline-flex items-center justify-center px-5" style="min-height:44px"><%= whatsapp_label %></a>
    </nav>
  </section>
</main>
