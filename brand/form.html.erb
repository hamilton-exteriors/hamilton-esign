<!DOCTYPE html>
<html data-theme="docuseal" lang="<%= I18n.locale %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <% if ENV['ROLLBAR_CLIENT_TOKEN'] %>
      <meta name="rollbar-token" content="<%= ENV.fetch('ROLLBAR_CLIENT_TOKEN', nil) %>">
      <%= javascript_pack_tag 'rollbar', 'form', defer: true %>
    <% else %>
      <%= javascript_pack_tag 'form', defer: true %>
    <% end %>
    <%= stylesheet_pack_tag 'form', media: 'all' %>
    <%# No external font stylesheet: DocuSeal's CSP is style-src 'self'
        'unsafe-inline', which blocks fonts.googleapis.com outright. DM Sans is
        self-hosted from /fonts/ and declared inside the inline block below. %>
    <link rel="preload" as="font" type="font/woff2"
          href="/fonts/dm-sans-latin.woff2" crossorigin>
    <%# Hamilton brand layer, loaded last so it wins over the packed theme %>
    <style><%= Rails.root.join('app/assets/hamilton.css').read.html_safe %></style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
