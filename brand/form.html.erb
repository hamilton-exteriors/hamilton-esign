<!DOCTYPE html>
<html data-theme="docuseal" lang="<%= I18n.locale %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <% if ENV['ROLLBAR_CLIENT_TOKEN'] %>
      <meta name="rollbar-token" content="<%= ENV.fetch('ROLLBAR_CLIENT_TOKEN', nil) %>">
      <%= javascript_pack_tag 'rollbar', 'form', defer: true %>
    <% else %>
      <%= javascript_pack_tag 'form', defer: true %>
    <% end %>
    <%= stylesheet_pack_tag 'form', media: 'all' %>
    <%# No external font stylesheet: DocuSeal's CSP is style-src 'self'
        'unsafe-inline', which blocks fonts.googleapis.com outright. DM Sans is
        self-hosted from /fonts/ and declared inside the inline block below. %>
    <link rel="preload" as="font" type="font/woff2"
          href="/fonts/dm-sans-latin.woff2" crossorigin>
    <%# Hamilton brand layer, loaded last so it wins over the packed theme %>
    <style><%= Rails.root.join('app/assets/hamilton.css').read.html_safe %></style>
  </head>
  <body>
    <%= yield %>
    <%# Format phone fields as they are typed.
        DocuSeal's phone type gives an input[type=tel], so a phone at least gets
        the numeric keypad and a "234 567-8900" hint, but it does not insert the
        parentheses or the dash. Nobody signing a document should be punching in
        punctuation.
        Runs in the CAPTURE phase on document, so the value is already formatted
        by the time the Vue v-model listener on the element reads it. That avoids
        re-dispatching a synthetic input event, which would double-fire the
        component. Delegated, so fields Vue renders later are covered too.
        nonce is required: the CSP is script-src 'self' plus a nonce. %>
    <%# Mobile reading view.
        DocuSeal renders each page as a rasterised image scaled to the container,
        so on a phone a Letter sheet lands near 0.46 scale and body type around
        6.4 CSS px. Adobe and DocuSign both answer this by serving a second,
        reflowed rendering of the same source and keeping the PDF as the signed
        artifact. This adds that second rendering.
        Purely presentational and purely additive: it inserts a panel above the
        document, and every value is still captured by DocuSeal's own field
        components against the same field UUIDs. The executed PDF is filled from
        the print coordinates either way, so the record does not depend on this. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        var labels = <%= json_escape({
          readable_view: I18n.t('hamilton.signing.readable_view', default: I18n.locale.to_s.start_with?('es') ? 'Vista legible' : 'Readable view'),
          show_readable_view: I18n.t('hamilton.signing.show_readable_view', default: I18n.locale.to_s.start_with?('es') ? 'Mostrar vista legible' : 'Show readable view'),
          show_page: I18n.t('hamilton.signing.show_page', default: I18n.locale.to_s.start_with?('es') ? 'Mostrar la página' : 'Show the page'),
          loading_readable_view: I18n.t('hamilton.signing.loading_readable_view', default: I18n.locale.to_s.start_with?('es') ? 'Cargando la vista legible.' : 'Loading readable view.'),
          readable_view_shown: I18n.t('hamilton.signing.readable_view_shown', default: I18n.locale.to_s.start_with?('es') ? 'Se muestra la vista legible.' : 'Readable view shown.'),
          page_shown: I18n.t('hamilton.signing.page_shown', default: I18n.locale.to_s.start_with?('es') ? 'Se muestra la página del documento.' : 'Document page shown.'),
          readable_view_unavailable: I18n.t('hamilton.signing.readable_view_unavailable', default: I18n.locale.to_s.start_with?('es') ? 'La vista legible no está disponible. Usa la página del documento.' : 'Readable view is unavailable. Use the document page.')
        }.to_json).html_safe %>;
        var MOBILE = window.matchMedia('(max-width: 767px)');
        var mounted = false;
        var observer;

        function mountSignerHeader() {
          var header = document.getElementById('signing_form_header');
          if (!header || header.classList.contains('hx-signer-header')) return;
          var title = header.querySelector(':scope > h1');
          var actions = header.querySelector(':scope > .group');
          var brand = document.querySelector('.hx-brand');
          if (!title || !actions || !brand) return;

          var brandRow = brand.parentElement;
          var identity = document.createElement('div');
          identity.className = 'hx-signer-identity';
          identity.appendChild(brand);
          identity.appendChild(title);
          header.insertBefore(identity, actions);
          header.classList.add('hx-signer-header');
          actions.classList.add('hx-signer-actions');
          if (brandRow && !brandRow.children.length) brandRow.remove();
        }

        function titleOf() {
          var h = document.querySelector('h1');
          return h ? h.textContent.trim().replace(/\s+/g, ' ') : '';
        }

        // Completion, decline, and landing pages can share this layout. Do not
        // request a reflow asset unless DocuSeal has rendered signing fields.
        function signingHost() {
          var pages = document.querySelectorAll('page-container');
          if (!pages.length || !pages[0].parentNode) return null;
          for (var i = 0; i < pages.length; i++) {
            if (pages[i].querySelector('.field-area, .submitter-field')) return pages[0];
          }
          return null;
        }

        function syncProgressCurrent() {
          var rail = document.querySelector('.form-container .steps-progress');
          if (!rail) return;
          var marker = rail.querySelector('.steps-progress-current');
          if (!marker) return;
          var current = marker.matches('button') ? marker : marker.closest('button') || marker.querySelector('button');
          if (!current) return;
          var buttons = rail.querySelectorAll('button');
          for (var i = 0; i < buttons.length; i++) buttons[i].removeAttribute('aria-current');
          current.setAttribute('aria-current', 'step');
        }

        var progressObserver = new MutationObserver(syncProgressCurrent);
        progressObserver.observe(document.documentElement, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['class']
        });
        syncProgressCurrent();

        function mountControl() {
          if (mounted || document.getElementById('hx-read')) return;
          var host = signingHost();
          if (!host || !MOBILE.matches) return;
          mounted = true;
          observer.disconnect();
          var wrap = document.createElement('div');
          wrap.id = 'hx-read';
          wrap.innerHTML = '<div class="hx-read-bar"><span></span><button type="button" id="hx-read-toggle" aria-controls="hx-read-doc" aria-expanded="false"></button><span id="hx-read-status" class="hx-read-status" role="status" aria-live="polite" aria-atomic="true"></span></div><div id="hx-read-doc" hidden></div>';
          host.parentNode.insertBefore(wrap, host);

          var pages = document.querySelectorAll('page-container');
          var readDoc = wrap.querySelector('#hx-read-doc');
          var label = wrap.querySelector('.hx-read-bar > span');
          var toggle = wrap.querySelector('#hx-read-toggle');
          var status = wrap.querySelector('#hx-read-status');
          var tray = document.querySelector('.form-container');
          var loaded = false;
          var loading = false;
          var reflowInvalid = false;
          var showingReflow = false;
          var expectedUuids = [];
          label.textContent = labels.readable_view;
          toggle.textContent = labels.show_readable_view;

          var announce = function (message) {
            status.textContent = '';
            requestAnimationFrame(function () { status.textContent = message; });
          };
          var updateFormClearance = function () {
            var height = 0;
            if (MOBILE.matches && tray) {
              var style = window.getComputedStyle(tray);
              var rect = tray.getBoundingClientRect();
              var fixedToViewport = false;
              var parent = tray;
              while (parent && parent !== document.body) {
                if (window.getComputedStyle(parent).position === 'fixed') {
                  fixedToViewport = true;
                  break;
                }
                parent = parent.parentElement;
              }
              if (fixedToViewport && style.display !== 'none' && style.visibility !== 'hidden') {
                height = Math.ceil(rect.height);
              }
            }
            document.documentElement.style.setProperty('--hx-form-clearance', height + 'px');
          };
          if (tray && window.ResizeObserver) {
            new ResizeObserver(updateFormClearance).observe(tray);
          }
          window.addEventListener('resize', updateFormClearance);
          if (window.visualViewport) window.visualViewport.addEventListener('resize', updateFormClearance);
          updateFormClearance();

          var retarget = function () {
            // Vue's Teleports are not reactive to DOM visibility. Every view
            // transition must force the field components to choose targets again.
            window.dispatchEvent(new Event('hx-reflow-ready'));
          };
          var focusPdfField = function () {
            requestAnimationFrame(function () {
              var field = document.querySelector('page-container .field-area, page-container .submitter-field');
              if (!field || typeof field.focus !== 'function') return;
              try { field.focus({ preventScroll: true }); }
              catch (error) { field.focus(); }
            });
          };
          var showPdf = function (announceChange) {
            document.documentElement.classList.remove('hx-readable-active');
            for (var i = 0; i < pages.length; i++) pages[i].style.display = '';
            readDoc.hidden = true;
            showingReflow = false;
            toggle.setAttribute('aria-expanded', 'false');
            toggle.removeAttribute('aria-busy');
            if (!reflowInvalid) {
              label.textContent = labels.readable_view;
              toggle.hidden = false;
              toggle.textContent = labels.show_readable_view;
            }
            retarget();
            updateFormClearance();
            if (announceChange) announce(labels.page_shown);
          };
          var failReflow = function () {
            reflowInvalid = true;
            showPdf(false);
            loading = false;
            toggle.disabled = true;
            toggle.hidden = true;
            label.textContent = labels.readable_view_unavailable;
            wrap.removeAttribute('aria-busy');
            announce(labels.readable_view_unavailable);
            focusPdfField();
          };
          var snapshotPdfFields = function () {
            var fields = document.querySelectorAll('page-container .field-area, page-container .submitter-field');
            var seen = {};
            expectedUuids = [];
            for (var i = 0; i < fields.length; i++) {
              var uuid = fields[i].getAttribute('data-uuid');
              if (!uuid || seen[uuid]) return false;
              seen[uuid] = true;
              expectedUuids.push(uuid);
            }
            return expectedUuids.length > 0;
          };
          var showReflow = function () {
            if (!MOBILE.matches || reflowInvalid || !loaded) {
              showPdf(false);
              return;
            }

            // Keep the PDF visible while Vue retargets. Hiding it first turns a
            // missing or stale UUID into an invisible required field.
            readDoc.hidden = false;
            for (var i = 0; i < pages.length; i++) pages[i].style.display = '';
            retarget();
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                if (!MOBILE.matches) {
                  showPdf(false);
                  return;
                }
                var stranded = document.querySelector('page-container .field-area, page-container .submitter-field');
                var inlineFields = readDoc.querySelectorAll('.field-area, .submitter-field');
                var inlineUuids = {};
                var complete = inlineFields.length === expectedUuids.length;
                for (var j = 0; j < inlineFields.length; j++) {
                  var uuid = inlineFields[j].getAttribute('data-uuid');
                  if (!uuid || inlineUuids[uuid]) complete = false;
                  inlineUuids[uuid] = true;
                }
                for (var k = 0; k < expectedUuids.length; k++) {
                  if (!inlineUuids[expectedUuids[k]]) complete = false;
                }
                if (stranded || !complete) {
                  // Reflow is an enhancement. Any field that failed to move makes
                  // the exact PDF the safe, signable fallback for this session.
                  failReflow();
                  return;
                }
                for (var i = 0; i < pages.length; i++) pages[i].style.display = 'none';
                document.documentElement.classList.add('hx-readable-active');
                showingReflow = true;
                toggle.setAttribute('aria-expanded', 'true');
                toggle.textContent = labels.show_page;
                announce(labels.readable_view_shown);
                updateFormClearance();
              });
            });
          };
          var loadReflow = function () {
            if (loading || reflowInvalid) return;
            if (!snapshotPdfFields()) {
              failReflow();
              return;
            }
            if (loaded) {
              showReflow();
              return;
            }
            loading = true;
            toggle.disabled = true;
            toggle.setAttribute('aria-busy', 'true');
            wrap.setAttribute('aria-busy', 'true');
            announce(labels.loading_readable_view);
            fetch('/reflow/index.json', { credentials: 'same-origin' })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (idx) {
                var slug = idx && idx[titleOf()];
                if (!slug) return null;
                return fetch('/reflow/' + slug + '.reflow.html', { credentials: 'same-origin' })
                  .then(function (r) { return r.ok ? r.text() : null; });
              })
              .then(function (html) {
                if (!MOBILE.matches) {
                  showPdf(false);
                  return;
                }
                if (!html) {
                  failReflow();
                  return;
                }
                // Injected into THIS document, not an iframe. Vue's Teleport
                // cannot cross documents, and fields must land in the text.
                readDoc.innerHTML = html;
                loaded = true;
                showReflow();
              })
              .catch(function () {
                if (MOBILE.matches) failReflow();
              })
              .finally(function () {
                loading = false;
                wrap.removeAttribute('aria-busy');
                toggle.removeAttribute('aria-busy');
                if (!reflowInvalid) toggle.disabled = false;
              });
          };

          toggle.addEventListener('click', function () {
            if (showingReflow) showPdf(true);
            else loadReflow();
          });
          MOBILE.addEventListener('change', function () {
            // Crossing 768px must always restore the PDF. Returning to mobile
            // remains PDF-first; a signer explicitly chooses readable view again.
            var focusWasInside = wrap.contains(document.activeElement);
            showPdf(showingReflow);
            if (!MOBILE.matches && focusWasInside) focusPdfField();
          });
        }

        observer = new MutationObserver(function () {
          mountSignerHeader();
          mountControl();
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });
        // The form bundle is deferred. Watch for its fields, and also cover a
        // desktop-first session that rotates or resizes into the mobile view.
        MOBILE.addEventListener('change', function () {
          if (MOBILE.matches) mountControl();
        });
        mountSignerHeader();
        mountControl();
      })();
    </script>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        function fmt(raw) {
          var value = String(raw == null ? '' : raw);
          // Shared-link phone inputs require international numbers to retain the
          // leading +. Only prettify a recognizable US number.
          if (value.trim().charAt(0) === '+') return value;
          var d = value.replace(/\D/g, '');
          if (d.length === 11 && d.charAt(0) === '1') d = d.slice(1);
          if (d.length > 10) return value;
          if (d.length <= 3) return d;
          if (d.length <= 6) return '(' + d.slice(0, 3) + ') ' + d.slice(3);
          return '(' + d.slice(0, 3) + ') ' + d.slice(3, 6) + '-' + d.slice(6);
        }
        document.addEventListener('input', function (e) {
          var el = e.target;
          if (!el || el.tagName !== 'INPUT' || el.type !== 'tel') return;
          var next = fmt(el.value);
          if (next === el.value) return;
          el.value = next;
          try { el.setSelectionRange(next.length, next.length); } catch (err) { /* not selectable */ }
        }, true);
      })();
    </script>
    <script nonce="<%= content_security_policy_nonce %>" data-hx-spanish-locale>
      (function () {
        // A Spanish template is an explicit language choice. Existing signing
        // links predate locale-aware delivery, so send those templates through
        // DocuSeal's own public `lang` path instead of translating a handful of
        // controls after render and leaving the rest of the signer UI in English.
        var spanishTitles = {
          'Contrato de Empleo': true,
          'Aviso de Salario - Código Laboral 2810.5': true,
          'Acuse de Recibo de Políticas': true,
          'Registro de Capacitación en Seguridad': true,
          'Plan de Prevención de Enfermedades por Calor': true
        };
        var heading = document.querySelector('h1');
        var title = heading ? heading.textContent.trim().replace(/\s+/g, ' ') : '';
        if (!spanishTitles[title]) return;
        var url = new URL(window.location.href);
        if (url.searchParams.get('lang') === 'es') return;
        url.searchParams.set('lang', 'es');
        window.location.replace(url.toString());
      })();
    </script>
  </body>
</html>
