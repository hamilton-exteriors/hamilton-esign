<!DOCTYPE html>
<html data-theme="docuseal" lang="<%= I18n.locale %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <% if ENV['ROLLBAR_CLIENT_TOKEN'] %>
      <meta name="rollbar-token" content="<%= ENV.fetch('ROLLBAR_CLIENT_TOKEN', nil) %>">
      <%= javascript_pack_tag 'rollbar', 'form', defer: true %>
    <% else %>
      <%= javascript_pack_tag 'form', defer: true %>
    <% end %>
    <%= stylesheet_pack_tag 'form', media: 'all' %>
    <%# No external font stylesheet: DocuSeal's CSP is style-src 'self'
        'unsafe-inline', which blocks fonts.googleapis.com outright. DM Sans is
        self-hosted from /fonts/ and declared inside the inline block below. %>
    <link rel="preload" as="font" type="font/woff2"
          href="/fonts/dm-sans-latin.woff2" crossorigin>
    <%# Hamilton brand layer, loaded last so it wins over the packed theme %>
    <style><%= Rails.root.join('app/assets/hamilton.css').read.html_safe %></style>
  </head>
  <body>
    <%= yield %>
    <%# Format phone fields as they are typed.
        DocuSeal's phone type gives an input[type=tel], so a phone at least gets
        the numeric keypad and a "234 567-8900" hint, but it does not insert the
        parentheses or the dash. Nobody signing a document should be punching in
        punctuation.
        Runs in the CAPTURE phase on document, so the value is already formatted
        by the time the Vue v-model listener on the element reads it. That avoids
        re-dispatching a synthetic input event, which would double-fire the
        component. Delegated, so fields Vue renders later are covered too.
        nonce is required: the CSP is script-src 'self' plus a nonce. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        function fmt(raw) {
          var d = String(raw == null ? '' : raw).replace(/\D/g, '');
          if (d.length === 11 && d.charAt(0) === '1') d = d.slice(1);
          d = d.slice(0, 10);
          if (d.length <= 3) return d;
          if (d.length <= 6) return '(' + d.slice(0, 3) + ') ' + d.slice(3);
          return '(' + d.slice(0, 3) + ') ' + d.slice(3, 6) + '-' + d.slice(6);
        }
        document.addEventListener('input', function (e) {
          var el = e.target;
          if (!el || el.tagName !== 'INPUT' || el.type !== 'tel') return;
          var next = fmt(el.value);
          if (next === el.value) return;
          el.value = next;
          try { el.setSelectionRange(next.length, next.length); } catch (err) { /* not selectable */ }
        }, true);
      })();
    </script>
  </body>
</html>
