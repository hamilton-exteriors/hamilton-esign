<main class="max-w-md mx-auto px-4 mt-12 mb-4 text-center" aria-labelledby="terminal-heading">
  <%= render 'shared/logo', height: 64 %>
  <h1 id="terminal-heading" class="mt-6 text-xl font-semibold"><%= heading %></h1>
  <p class="mt-3" dir="auto"><%= message %></p>
  <%= local_assigns[:actions] %>
  <%= render 'shared/attribution', link_path: (local_assigns[:link_path] || '/start'), account: local_assigns[:account] %>
</main>
